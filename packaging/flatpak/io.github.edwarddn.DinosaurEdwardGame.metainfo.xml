<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.edwarddn.DinosaurEdwardGame</id>
  <name>Dinosaur Edward Game</name>
  <summary>Dinosaur game with an AI trained by a genetic algorithm</summary>
  <developer id="io.github.edwarddn">
    <name>Edward</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      A dinosaur runner game built from scratch in Java, with its own physics and rendering.
      Play alone, play against an artificial intelligence, or watch a neural network learn
      to play through a genetic algorithm.
    </p>
    <ul>
      <li>Jump and crouch to avoid cacti and birds</li>
      <li>Play against a trained neural network</li>
      <li>Train the AI and keep the learned weights</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.edwarddn.DinosaurEdwardGame.desktop</launchable>

